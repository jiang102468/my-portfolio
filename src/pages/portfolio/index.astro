---
// /portfolio/ —— 作品集在线查看器（仿 PDF 阅读器）
// 设计依据：DESIGN.md（Apple 画廊语法：深色舞台 + 浅色缩略图带 + 单一 Action Blue）
// 图片资源：public/portfolio/<slug>/（cover.webp + pNN.webp，由 optimize-portfolio.py 生成）
// 数据源：src/data/portfolio.ts
import Layout from '../../layouts/Layout.astro';
import { portfolio } from '../../data/portfolio';
import { site } from '../../site.config';

const projects = portfolio;
const first = projects[0];
const totalPages = projects.reduce((n, p) => n + p.pages.length, 0);
const seoDesc = `${site.name}的设计作品集在线预览：${projects.map((p) => p.title).join(' / ')}，共 ${projects.length} 个项目、${totalPages} 页设计稿，支持下载完整 PDF 作品集。`;

// 传给前端的紧凑数据（只保留渲染所需字段）
const viewerData = projects.map((p) => ({
  slug: p.slug,
  title: p.title,
  subtitle: p.subtitle ?? '',
  category: p.category,
  year: p.year,
  description: p.description,
  pages: p.pages.map((pg) => pg.src),
}));
---

<Layout title="作品集" description={seoDesc}>
  <!-- 头部：深色沉浸瓦片（tile-void 纯黑，环境页语法） -->
  <section class="pf-hero tile-void">
    <div class="container pf-hero-inner">
      <p class="eyebrow pf-eyebrow fade-up">Portfolio · {projects.length} 个项目</p>
      <h1 class="pf-title fade-up fade-up-1">设计作品集</h1>
      <p class="pf-desc fade-up fade-up-2">
        完整设计作品集在线预览，覆盖
        <span class="pf-desc-strong">{projects.map((p) => p.title).join(' / ')}</span>
        等方向。也可直接下载 PDF 版本。
      </p>
      <div class="pf-hero-actions fade-up fade-up-3">
        <a href={site.contact.pdfHref} download class="btn btn-primary">
          {site.contact.pdfLabel} ↓
        </a>
        <a href={site.nav.cta.href} class="btn btn-outline">{site.nav.cta.label}</a>
      </div>
    </div>
  </section>

  <!-- 项目切换条：毛玻璃吸顶（sub-nav-frosted 语法） -->
  <nav class="pf-tabs" aria-label="项目切换" data-tabs>
    <div class="pf-tabs-inner">
      {
        projects.map((p, i) => (
          <button
            type="button"
            class:list={['pf-tab', i === 0 && 'is-active']}
            data-tab={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {p.title}
            <span class="pf-tab-count">{p.pages.length}</span>
          </button>
        ))
      }
    </div>
  </nav>

  <!-- 主查看舞台：深色瓦片，设计稿在深底上发光 -->
  <main class="pf-stage" aria-live="polite" data-stage>
    <!-- 舞台顶部信息 -->
    <div class="pf-stage-meta">
      <div class="pf-meta-left">
        <h2 class="pf-stage-title" data-stage-title>{first.title}</h2>
        <div class="pf-stage-tags">
          <span class="tag" data-stage-category>{first.category}</span>
          <span class="tag tag-year" data-stage-year>{first.year}</span>
        </div>
      </div>
      <div class="pf-meta-right">
        <button type="button" class="pf-fullscreen" data-fullscreen aria-label="全屏查看">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M8 3H5a2 2 0 0 0-2 2v3" />
            <path d="M21 8V5a2 2 0 0 0-2-2h-3" />
            <path d="M3 16v3a2 2 0 0 0 2 2h3" />
            <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 舞台主体 -->
    <div class="pf-viewport" data-viewport>
      <button type="button" class="pf-arrow pf-arrow-prev" data-prev aria-label="上一页">‹</button>
      <div class="pf-image-wrap">
        <img
          class="pf-image"
          src={first.pages[0].src}
          alt={`${first.title} 第 1 页`}
          width="1600"
          height="900"
          data-image
        />
      </div>
      <button type="button" class="pf-arrow pf-arrow-next" data-next aria-label="下一页">›</button>

      <div class="pf-counter">
        <span data-page>1</span> / <span data-page-total>{first.pages.length}</span>
      </div>
    </div>

    <!-- 缩略图带（浅色） -->
    <div class="pf-thumb-strip">
      <div class="pf-thumbs" data-thumbs>
        {
          first.pages.map((pg, i) => (
            <button
              type="button"
              class:list={['pf-thumb', i === 0 && 'is-active']}
              data-thumb={i}
              aria-label={`第 ${i + 1} 页`}
            >
              <img src={pg.src} alt="" width="96" height="54" loading="lazy" />
            </button>
          ))
        }
      </div>
    </div>
  </main>

  <!-- 项目简介（浅色瓦片） -->
  <section class="pf-about tile-light">
    <div class="container pf-about-inner">
      <div class="pf-about-copy">
        <h3 class="pf-about-title" data-about-title>{first.title}</h3>
        {first.subtitle && <p class="pf-about-sub" data-about-sub>{first.subtitle}</p>}
        <p class="pf-about-desc" data-about-desc>{first.description}</p>
      </div>
      <div class="pf-about-side">
        <h4 class="eyebrow">查看项目详情</h4>
        <a href={`/projects/${first.slug}/`} class="btn btn-outline pf-about-link" data-about-link>
          进入案例页 ↗
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============ 头部：深色沉浸瓦片 ============ */
  .pf-hero {
    padding-block: clamp(80px, 12vw, 144px);
    text-align: center;
  }

  .pf-hero-inner {
    max-width: 760px;
  }

  .pf-eyebrow {
    margin-bottom: 20px;
    color: var(--on-inverse-muted);
  }

  .pf-title {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.07;
  }

  .pf-desc {
    margin: 24px auto 0;
    max-width: 560px;
    font-size: var(--text-lg);
    color: var(--on-inverse-muted);
    line-height: 1.47;
  }

  .pf-desc-strong {
    color: var(--on-inverse);
    font-weight: 600;
  }

  .pf-hero-actions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ============ 项目切换条：毛玻璃吸顶 ============ */
  .pf-tabs {
    position: sticky;
    top: var(--header-h);
    z-index: 90;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .pf-tabs-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 8px var(--gutter);
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pf-tabs-inner::-webkit-scrollbar {
    display: none;
  }

  .pf-tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    letter-spacing: -0.224px;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
    white-space: nowrap;
  }

  .pf-tab:hover {
    color: var(--text);
  }

  .pf-tab:active {
    transform: scale(0.95);
  }

  .pf-tab.is-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .pf-tab-count {
    font-size: 11px;
    font-weight: 400;
    color: currentColor;
    opacity: 0.55;
  }

  /* ============ 主查看舞台：深色 ============ */
  .pf-stage {
    background: var(--tile-dark);
    color: var(--on-inverse);
    --accent: var(--accent-on-dark);
    --text-secondary: var(--on-inverse-muted);
    --border: var(--border-inverse);
    --surface-muted: rgb(255 255 255 / 0.12);
    padding-block: 32px;
  }

  /* 舞台顶部信息条 */
  .pf-stage-meta {
    max-width: var(--container);
    margin-inline: auto;
    padding: 0 var(--gutter) 24px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .pf-stage-title {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .pf-stage-tags {
    margin-top: 12px;
    display: flex;
    gap: 8px;
  }

  .pf-stage-tags .tag {
    color: var(--on-inverse-muted);
    background: rgb(255 255 255 / 0.12);
  }

  .pf-stage-tags .tag-year {
    background: transparent;
    border-color: var(--border-inverse);
  }

  /* 全屏按钮：44×44 玻璃圆钮（button-icon-circular 语法） */
  .pf-fullscreen {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--on-inverse);
    background: color-mix(in srgb, var(--on-inverse) 22%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    transition: background-color var(--dur) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .pf-fullscreen:hover {
    background: color-mix(in srgb, var(--on-inverse) 34%, transparent);
  }

  .pf-fullscreen:active {
    transform: scale(0.95);
  }

  /* 舞台主体 */
  .pf-viewport {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(68vh, 720px);
  }

  .pf-image-wrap {
    max-width: 100%;
    /* 设计稿在深底上：发丝线分隔 + 唯一的 product shadow（规范允许内容图落影） */
    box-shadow: var(--shadow-product);
  }

  .pf-image {
    display: block;
    max-width: 100%;
    max-height: min(68vh, 720px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-inverse);
    cursor: zoom-in;
    transition: transform var(--dur-slow) var(--ease);
  }

  /* 左右箭头：44px 玻璃圆钮 */
  .pf-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 22px;
    line-height: 1;
    color: var(--on-inverse);
    background: color-mix(in srgb, var(--on-inverse) 22%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
    z-index: 2;
  }

  .pf-arrow:hover {
    background: color-mix(in srgb, var(--on-inverse) 34%, transparent);
  }

  .pf-arrow:active {
    transform: translateY(-50%) scale(0.95);
  }

  .pf-arrow-prev {
    left: var(--gutter);
  }

  .pf-arrow-next {
    right: var(--gutter);
  }

  /* 页码指示 */
  .pf-counter {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--on-inverse-muted);
    letter-spacing: -0.224px;
  }

  /* ============ 缩略图带：浅色 ============ */
  .pf-thumb-strip {
    background: var(--bg);
    border-top: 1px solid var(--border);
    margin-top: 32px;
  }

  .pf-thumbs {
    max-width: var(--container);
    margin-inline: auto;
    padding: 16px var(--gutter);
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pf-thumbs::-webkit-scrollbar {
    display: none;
  }

  .pf-thumb {
    flex: 0 0 auto;
    width: 92px;
    height: 58px;
    border-radius: var(--radius-sm);
    border: 2px solid transparent;
    overflow: hidden;
    padding: 0;
    background: var(--surface-muted);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .pf-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pf-thumb:hover {
    border-color: var(--border);
  }

  .pf-thumb:active {
    transform: scale(0.95);
  }

  .pf-thumb.is-active {
    border-color: var(--accent);
  }

  /* ============ 项目简介 ============ */
  .pf-about {
    padding-block: clamp(64px, 8vw, 96px);
  }

  .pf-about-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .pf-about-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .pf-about-sub {
    margin-top: 10px;
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .pf-about-desc {
    margin-top: 16px;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .pf-about-side {
    text-align: right;
  }

  .pf-about-side .eyebrow {
    margin-bottom: 14px;
  }

  .pf-about-link {
    min-height: 44px;
  }

  /* ============ 全屏灯箱（lightbox） ============ */
  .pf-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgb(0 0 0 / 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    cursor: zoom-out;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease);
  }

  .pf-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .pf-lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .pf-lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 24px;
    color: #fff;
    background: color-mix(in srgb, #fff 22%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
  }

  .pf-lightbox-close:active {
    transform: scale(0.95);
  }

  .pf-lightbox-counter {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    color: rgb(255 255 255 / 0.7);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* ============ 响应式 ============ */
  @media (max-width: 768px) {
    .pf-viewport {
      min-height: 52vh;
      padding-inline: calc(var(--gutter) + 36px);
    }

    .pf-image {
      max-height: 52vh;
    }

    .pf-about-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .pf-about-side {
      text-align: left;
    }

    .pf-stage-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .pf-meta-right {
      position: absolute;
      top: 16px;
      right: var(--gutter);
    }

    .pf-stage-meta {
      position: relative;
      padding-right: calc(var(--gutter) + 56px);
    }
  }

  @media (max-width: 640px) {
    .pf-viewport {
      min-height: 46vh;
    }

    .pf-image {
      max-height: 46vh;
    }
  }
</style>

<script is:inline define:vars={{ viewerData }}>
  // 把服务端数据挂到 window，供打包后的查看器脚本读取
  window.__PORTFOLIO_DATA__ = viewerData;
</script>

<script>
  // ============================================================
  // 作品集查看器逻辑：tab 切换 / 翻页 / 键盘 / 灯箱 / 全屏
  // ============================================================
  const data: { slug: string; title: string; subtitle?: string; category: string; year: string; description: string; pages: string[] }[] =
    (window as any).__PORTFOLIO_DATA__;

  const el = {
    tabs: document.querySelectorAll<HTMLButtonElement>('[data-tab]'),
    title: document.querySelector<HTMLElement>('[data-stage-title]')!,
    category: document.querySelector<HTMLElement>('[data-stage-category]')!,
    year: document.querySelector<HTMLElement>('[data-stage-year]')!,
    image: document.querySelector<HTMLImageElement>('[data-image]')!,
    page: document.querySelector<HTMLElement>('[data-page]')!,
    pageTotal: document.querySelector<HTMLElement>('[data-page-total]')!,
    thumbs: document.querySelector<HTMLElement>('[data-thumbs]')!,
    prev: document.querySelector<HTMLButtonElement>('[data-prev]')!,
    next: document.querySelector<HTMLButtonElement>('[data-next]')!,
    fullscreen: document.querySelector<HTMLButtonElement>('[data-fullscreen]')!,
    aboutTitle: document.querySelector<HTMLElement>('[data-about-title]')!,
    aboutSub: document.querySelector<HTMLElement>('[data-about-sub]')!,
    aboutDesc: document.querySelector<HTMLElement>('[data-about-desc]')!,
    aboutLink: document.querySelector<HTMLAnchorElement>('[data-about-link]')!,
  };

  let current = 0; // 当前项目索引
  let page = 0;    // 当前页索引

  // 预加载相邻页，避免翻页白屏
  const preload = (src: string) => {
    const link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'image';
    link.href = src;
    document.head.appendChild(link);
  };

  function render() {
    const project = data[current];
    const total = project.pages.length;

    el.title.textContent = project.title;
    el.category.textContent = project.category;
    el.year.textContent = project.year;
    el.page.textContent = String(page + 1);
    el.pageTotal.textContent = String(total);

    el.image.src = project.pages[page];
    el.image.alt = `${project.title} 第 ${page + 1} 页`;

    // 缩略图重建
    el.thumbs.innerHTML = '';
    project.pages.forEach((src, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pf-thumb' + (i === page ? ' is-active' : '');
      btn.dataset.thumb = String(i);
      btn.setAttribute('aria-label', `第 ${i + 1} 页`);
      const img = document.createElement('img');
      img.src = src;
      img.alt = '';
      img.width = 96;
      img.height = 54;
      img.loading = 'lazy';
      btn.appendChild(img);
      btn.addEventListener('click', () => go(i));
      el.thumbs.appendChild(btn);
    });

    // 滚动高亮当前缩略图
    const active = el.thumbs.querySelector('.is-active');
    active?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });

    // 预加载相邻
    if (page > 0) preload(project.pages[page - 1]);
    if (page < total - 1) preload(project.pages[page + 1]);

    // 简介区
    el.aboutTitle.textContent = project.title;
    if (project.subtitle) {
      el.aboutSub.textContent = project.subtitle;
      el.aboutSub.style.display = '';
    } else {
      el.aboutSub.style.display = 'none';
    }
    el.aboutDesc.textContent = project.description;
    el.aboutLink.href = `/projects/${project.slug}/`;

    // tab 高亮
    el.tabs.forEach((tab, i) => {
      const active = i === current;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-pressed', String(active));
    });

    // URL hash 同步（深链支持：/#slug/页码）
    history.replaceState(null, '', `#${project.slug}/${page + 1}`);
  }

  function go(index: number) {
    page = index;
    render();
  }

  function switchProject(index: number) {
    if (index === current) return;
    current = index;
    page = 0;
    render();
    // 滚动到舞台顶部，让用户立刻看到切换结果
    document.querySelector('[data-stage]')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }

  // tabs
  el.tabs.forEach((tab) => {
    tab.addEventListener('click', () => switchProject(Number(tab.dataset.tab)));
  });

  // 翻页
  el.prev.addEventListener('click', () => {
    if (page > 0) go(page - 1);
  });
  el.next.addEventListener('click', () => {
    const total = data[current].pages.length;
    if (page < total - 1) go(page + 1);
  });

  // 键盘：← → 翻页，Esc 关灯箱
  window.addEventListener('keydown', (event) => {
    const lightbox = document.querySelector<HTMLElement>('.pf-lightbox');
    if (lightbox?.classList.contains('is-open')) {
      if (event.key === 'Escape') closeLightbox();
      return;
    }
    if (event.key === 'ArrowLeft' && page > 0) go(page - 1);
    if (event.key === 'ArrowRight') {
      const total = data[current].pages.length;
      if (page < total - 1) go(page + 1);
    }
  });

  // 灯箱（点击放大）
  let lightbox: HTMLElement | null = null;
  function openLightbox() {
    if (lightbox) closeLightbox();
    const project = data[current];
    lightbox = document.createElement('div');
    lightbox.className = 'pf-lightbox';
    lightbox.innerHTML = `
      <button type="button" class="pf-lightbox-close" aria-label="关闭">×</button>
      <img src="${project.pages[page]}" alt="${el.title.textContent} 第 ${page + 1} 页" />
      <span class="pf-lightbox-counter">${page + 1} / ${project.pages.length}</span>
    `;
    document.body.appendChild(lightbox);
    requestAnimationFrame(() => lightbox!.classList.add('is-open'));
    document.body.style.overflow = 'hidden';

    lightbox.addEventListener('click', (event) => {
      if (!(event.target as HTMLElement).closest('img')) closeLightbox();
    });
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(() => {
      lightbox?.remove();
      lightbox = null;
    }, 240);
  }

  el.image.addEventListener('click', openLightbox);

  // 全屏查看（原生 Fullscreen API）
  el.fullscreen.addEventListener('click', () => {
    const stage = document.querySelector('[data-stage]') as HTMLElement;
    if (!document.fullscreenElement) {
      stage.requestFullscreen?.().catch(() => openLightbox());
    } else {
      document.exitFullscreen?.();
    }
  });

  // 深链初始化：支持 #slug/页码
  const hash = window.location.hash.replace(/^#/, '');
  if (hash) {
    const [slug, pageStr] = hash.split('/');
    const idx = data.findIndex((p) => p.slug === slug);
    if (idx >= 0) {
      current = idx;
      const wanted = Math.min(Math.max(parseInt(pageStr || '1', 10) - 1, 0), data[idx].pages.length - 1);
      page = Number.isFinite(wanted) ? wanted : 0;
    }
  }

  render();
</script>
