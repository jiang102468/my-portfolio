---
// 项目详情页：/projects/[slug]/
// 自动为 src/content/projects/ 下每个 md 文件生成页面
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, year, cover, tags, link } = project.data;
---

<Layout title={title} description={description}>
  <article class="project-page">
    <div class="container">
      <a href="/#work" class="back-link">← 返回作品列表</a>

      <header class="project-header">
        <div class="meta-row">
          {category && <span class="tag">{category}</span>}
          {year && <span class="tag tag-year">{year}</span>}
        </div>
        <h1 class="project-title">{title}</h1>
        {description && <p class="project-desc">{description}</p>}
        {
          tags && tags.length > 0 && (
            <ul class="tag-list">
              {tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
          )
        }
        {link && (
          <a href={link} target="_blank" rel="noreferrer" class="btn btn-outline visit-link">
            访问项目 ↗
          </a>
        )}
      </header>

      {
        cover ? (
          <img src={cover} alt={title} class="project-cover" />
        ) : (
          <div class="cover-placeholder" aria-hidden="true">
            <span>{title.charAt(0)}</span>
          </div>
        )
      }

      <div class="project-body">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .project-page {
    padding-block: 48px 96px;
  }

  .back-link {
    display: inline-block;
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 40px;
    transition: color var(--dur) var(--ease);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .project-header {
    max-width: 820px;
    margin-bottom: 48px;
  }

  .meta-row {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .tag {
    font-size: 12.5px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--surface-muted);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .tag-year {
    background: transparent;
    border: 1px solid var(--border);
  }

  .project-title {
    font-size: clamp(32px, 5.5vw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .project-desc {
    margin-top: 20px;
    font-size: clamp(16px, 2vw, 19px);
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 620px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .visit-link {
    margin-top: 32px;
  }

  .project-cover {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    margin-bottom: 64px;
  }

  .cover-placeholder {
    aspect-ratio: 16 / 7;
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
      linear-gradient(160deg, var(--surface-muted), var(--surface));
    margin-bottom: 64px;
  }

  .cover-placeholder span {
    font-size: clamp(56px, 10vw, 120px);
    font-weight: 700;
    color: color-mix(in srgb, var(--text) 14%, transparent);
  }

  .project-body {
    max-width: 720px;
    margin-inline: auto;
  }
</style>

<style is:global>
  /* 项目正文（markdown 渲染）排版 */
  .project-body > :first-child {
    margin-top: 0;
  }

  .project-body h2 {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 2.6em 0 0.8em;
    padding-top: 0.4em;
    border-top: 1px solid var(--border);
  }

  .project-body h3 {
    font-size: 19px;
    font-weight: 600;
    margin: 1.8em 0 0.6em;
  }

  .project-body p {
    margin: 1em 0;
    line-height: 2;
    color: var(--text);
  }

  .project-body ul,
  .project-body ol {
    margin: 1em 0;
    padding-left: 1.4em;
  }

  .project-body li {
    margin: 0.4em 0;
    line-height: 1.9;
    list-style: disc;
  }

  .project-body blockquote {
    margin: 1.6em 0;
    padding: 16px 22px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--text-secondary);
  }

  .project-body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface-muted);
    padding: 2px 7px;
    border-radius: 5px;
  }

  .project-body pre {
    margin: 1.6em 0;
    padding: 20px 24px;
    border-radius: var(--radius-md);
    background: var(--text);
    color: var(--bg);
    overflow-x: auto;
  }

  .project-body pre code {
    background: transparent;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.7;
  }

  .project-body img {
    border-radius: var(--radius-md);
    margin: 1.6em 0;
  }

  .project-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-body hr {
    margin: 3em 0;
    border: none;
    border-top: 1px solid var(--border);
  }
</style>
