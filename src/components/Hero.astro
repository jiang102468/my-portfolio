---
// 首屏 Hero：Apple 式居中大字 + 双胶囊 CTA + 规格栏
// 文案统一在 src/site.config.ts 的 hero 中维护
import { site } from '../site.config';

const { hero } = site;
---

<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow hero-eyebrow fade-up">{hero.eyebrow}</p>

    <h1 class="hero-title fade-up fade-up-1">
      {hero.intro}
      <span class="hero-name">{hero.name}</span>
      <br />
      {hero.titlePrefix}
      {hero.highlight}。
    </h1>

    <p class="hero-desc fade-up fade-up-2">{hero.description}</p>

    <div class="hero-actions fade-up fade-up-3">
      <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
      <a href={hero.secondaryCta.href} class="btn btn-outline">{hero.secondaryCta.label}</a>
    </div>

    <dl class="hero-meta fade-up fade-up-4">
      {
        hero.meta.map((meta) => (
          <div class="meta-item">
            <dt class="eyebrow meta-label">{meta.label}</dt>
            <dd>
              {meta.href ? (
                <a href={meta.href} class="text-link">{meta.value}</a>
              ) : (
                meta.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(88px, 12vw, 144px);
    padding-bottom: var(--space-section);
  }

  .hero-inner {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }

  .hero-eyebrow {
    margin-bottom: 24px;
  }

  /* Apple 签名式标题：56px / 600 / 紧字距，中文 34px 起步 */
  .hero-title {
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.14;
  }

  .hero-name {
    white-space: nowrap;
  }

  .hero-desc {
    margin-top: 28px;
    margin-inline: auto;
    max-width: 560px;
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .hero-actions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* 规格栏：上下发丝线 + 竖向分隔，Apple 参数表语法 */
  .hero-meta {
    margin-top: clamp(56px, 8vw, 88px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .meta-item {
    padding: 20px 24px;
  }

  .meta-item + .meta-item {
    border-left: 1px solid var(--border);
  }

  .meta-label {
    margin-bottom: 6px;
  }

  .meta-item dd {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .hero-meta {
      grid-template-columns: 1fr;
    }

    .meta-item {
      padding: 16px 4px;
    }

    .meta-item + .meta-item {
      border-left: none;
      border-top: 1px solid var(--border);
    }
  }
</style>
