---
// 首屏 Hero：名字 + 头衔 + 简介 + CTA
// 文案统一在 src/site.config.ts 的 hero 中维护
import { site } from '../site.config';

const { hero } = site;
---

<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow hero-eyebrow fade-up">{hero.eyebrow}</p>

    <h1 class="hero-title fade-up fade-up-1">
      {hero.intro}
      <span class="hero-name">{hero.name}</span>
      <br />
      {hero.titlePrefix}
      <span class="accent-underline">{hero.highlight}</span>。
    </h1>

    <p class="hero-desc fade-up fade-up-2">{hero.description}</p>

    <div class="hero-actions fade-up fade-up-3">
      <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
      <a href={hero.secondaryCta.href} class="btn btn-outline">{hero.secondaryCta.label}</a>
    </div>

    <dl class="hero-meta fade-up fade-up-4">
      {
        hero.meta.map((meta) => (
          <div class="meta-item">
            <dt class="eyebrow meta-label">{meta.label}</dt>
            <dd>
              {meta.href ? (
                <a href={meta.href} class="text-link">{meta.value}</a>
              ) : (
                meta.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(72px, 12vw, 140px);
    padding-bottom: var(--space-section);
  }

  .hero-eyebrow {
    margin-bottom: 28px;
  }

  .hero-title {
    font-size: clamp(38px, 7vw, 76px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    max-width: 16em;
  }

  .hero-name {
    position: relative;
    white-space: nowrap;
  }

  .hero-name::before {
    content: "";
    position: absolute;
    inset: auto -10px -4px -10px;
    height: 40%;
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    z-index: -1;
  }

  .accent-underline {
    color: var(--accent);
  }

  .hero-desc {
    margin-top: 36px;
    max-width: 560px;
    font-size: clamp(16px, 2vw, 19px);
    color: var(--text-secondary);
    line-height: 1.9;
  }

  .hero-actions {
    margin-top: 44px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-meta {
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
    max-width: 640px;
  }

  .meta-label {
    color: var(--text-tertiary);
    margin-bottom: 6px;
  }

  .meta-item dd {
    font-size: var(--text-md);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero-meta {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
