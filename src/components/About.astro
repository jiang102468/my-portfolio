---
// 关于区块：简介 + 技能 + 经历时间线
// 文字后期由你替换
const skills = [
  "界面设计 UI Design",
  "交互设计 UX Design",
  "设计系统 Design System",
  "产品思维",
  "Figma / Sketch",
  "原型与动效 Prototyping",
];

const timeline = [
  {
    period: "2023 — 至今",
    role: "高级 UI 设计师",
    company: "某某科技",
    note: "负责核心产品设计体系搭建与界面设计。",
  },
  {
    period: "2021 — 2023",
    role: "UI 设计师",
    company: "某某互联网公司",
    note: "参与 B 端中台与移动端产品设计。",
  },
  {
    period: "2020 — 2021",
    role: "初级设计师",
    company: "某某设计工作室",
    note: "从 0 到 1 接触完整设计流程。",
  },
];
---

<section id="about" class="section about">
  <div class="container">
    <div class="section-head">
      <span class="section-index">02 / About</span>
      <h2 class="section-title">关于我</h2>
    </div>

    <div class="about-grid">
      <div class="about-intro">
        <p class="lead">
          你好，我叫杨晓文，一名拥有 5 年经验的 UI 设计师。我相信好的设计是
          <em>克制而精准</em> 的——在理解用户与业务之后，用最简洁的形式
          呈现最清晰的体验。
        </p>
        <p>
          我热衷于设计系统与组件化思维，喜欢通过流程化、可复用的方式
          提升设计效率与产品一致性。工作之外，我也在持续探索
          AI 辅助设计与新交互形态的可能性。
        </p>
      </div>

      <div class="about-side">
        <h3 class="side-title">技能</h3>
        <ul class="skill-list">
          {
            skills.map((skill) => (
              <li class="skill-item">{skill}</li>
            ))
          }
        </ul>

        <h3 class="side-title">经历</h3>
        <ol class="timeline">
          {
            timeline.map((item) => (
              <li class="timeline-item">
                <span class="period">{item.period}</span>
                <div>
                  <p class="role">{item.role} · {item.company}</p>
                  <p class="note">{item.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .about-intro .lead {
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.8;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .about-intro .lead em {
    font-style: normal;
    color: var(--accent);
  }

  .about-intro p:not(.lead) {
    color: var(--text-secondary);
    line-height: 2;
    margin-bottom: 16px;
  }

  .side-title {
    font-size: 13px;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 20px;
  }

  .about-side .side-title:not(:first-child) {
    margin-top: 44px;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-item {
    font-size: 14px;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: all var(--dur) var(--ease);
  }

  .skill-item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .timeline {
    position: relative;
    padding-left: 20px;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -25px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--accent);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }

  .role {
    font-size: 15px;
    font-weight: 600;
    margin-top: 4px;
  }

  .note {
    font-size: 13.5px;
    color: var(--text-secondary);
    margin-top: 3px;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
