---
// 关于区块：简介 + 技能 + 经历时间线
// 文案统一在 src/site.config.ts 的 about 中维护
import { site } from '../site.config';

const { lead, paragraphs, skills, timeline } = site.about;
---

<section id="about" class="section about">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">02 / About</span>
      <h2 class="section-title">关于我</h2>
    </div>

    <div class="about-grid">
      <div class="about-intro">
        <p class="lead">
          {lead.greeting}
          <em>{lead.emphasis}</em>
          {lead.suffix}
        </p>
        {
          paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
      </div>

      <div class="about-side">
        <h3 class="eyebrow side-title">技能</h3>
        <ul class="skill-list">
          {
            skills.map((skill) => (
              <li class="skill-item">{skill}</li>
            ))
          }
        </ul>

        <h3 class="eyebrow side-title">经历</h3>
        <ol class="timeline">
          {
            timeline.map((item) => (
              <li class="timeline-item">
                <span class="period">{item.period}</span>
                <div>
                  <p class="role">{item.role} · {item.company}</p>
                  <p class="note">{item.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .about-intro .lead {
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.8;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .about-intro .lead em {
    font-style: normal;
    color: var(--accent);
  }

  .about-intro p:not(.lead) {
    color: var(--text-secondary);
    line-height: 2;
    margin-bottom: 16px;
  }

  .side-title {
    color: var(--text-tertiary);
    margin: 0 0 20px;
  }

  .about-side .side-title:not(:first-child) {
    margin-top: 44px;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-item {
    font-size: var(--text-md);
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .skill-item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .timeline {
    position: relative;
    padding-left: 20px;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -25px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--accent);
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }

  .role {
    font-size: var(--text-md);
    font-weight: 600;
    margin-top: 4px;
  }

  .note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: 3px;
  }

  /* 平板及以下单列 */
  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
