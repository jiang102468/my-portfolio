---
// 关于区块：简介 + 技能 + 经历（Apple 编辑式排版：引言 / 配置胶囊 / 参数行）
// 文案统一在 src/site.config.ts 的 about 中维护
import { site } from '../site.config';

const { lead, paragraphs, skills, timeline } = site.about;
---

<section id="about" class="section about">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">02 / About</span>
      <h2 class="section-title">关于我</h2>
    </div>

    <div class="about-grid">
      <div class="about-intro">
        <p class="lead">
          {lead.greeting}
          <em>{lead.emphasis}</em>
          {lead.suffix}
        </p>
        {
          paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
      </div>

      <div class="about-side">
        <h3 class="eyebrow side-title">技能</h3>
        <ul class="skill-list">
          {
            skills.map((skill) => (
              <li class="skill-item">{skill}</li>
            ))
          }
        </ul>

        <h3 class="eyebrow side-title">经历</h3>
        <ol class="timeline">
          {
            timeline.map((item) => (
              <li class="timeline-item">
                <span class="period">{item.period}</span>
                <div class="timeline-body">
                  <p class="role">{item.role} · {item.company}</p>
                  <p class="note">{item.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(48px, 6vw, 96px);
    align-items: start;
  }

  /* 引言：28px / 400，Apple「lead」语法 */
  .about-intro .lead {
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.5;
    margin-bottom: 28px;
  }

  .about-intro .lead em {
    font-style: normal;
    font-weight: 600;
  }

  .about-intro p:not(.lead) {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 16px;
  }

  .side-title {
    margin: 0 0 20px;
  }

  .about-side .side-title:not(:first-child) {
    margin-top: 52px;
  }

  /* 技能：白底胶囊 + 发丝线（Apple configurator chip） */
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-item {
    font-size: var(--text-sm);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    border: 1px solid var(--border);
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .skill-item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* 经历：参数行式（左侧年份 + 右侧责任），发丝线分隔 */
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }

  .timeline-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .period {
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--text-secondary);
    padding-top: 3px;
  }

  .role {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: 3px;
    line-height: 1.5;
  }

  /* 平板及以下单列 */
  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  /* 手机：经历行改为上下两行 */
  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
