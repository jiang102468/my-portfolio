---
// 联系区块：纯黑沉浸瓦片 + 居中大字 + 胶囊 CTA（Apple 深色编辑页语法）
// 文案与链接统一在 src/site.config.ts 的 contact 中维护
import { site } from '../site.config';

const { heading, subheading, email, ctaLabel, socials } = site.contact;
---

<section id="contact" class="contact tile-void">
  <div class="container contact-inner">
    <p class="eyebrow contact-eyebrow fade-up">03 / Contact</p>
    <h2 class="contact-title fade-up fade-up-1">
      {heading}
      <br />
      <span>{subheading}</span>
    </h2>

    <a href={`mailto:${email}`} class="btn btn-primary contact-btn fade-up fade-up-2">
      {ctaLabel}
    </a>

    <ul class="social-list fade-up fade-up-3">
      {
        socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noreferrer noopener" class="text-link">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(88px, 12vw, 152px);
  }

  .contact-inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .contact-eyebrow {
    margin-bottom: 24px;
  }

  .contact-title {
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.07;
  }

  .contact-title span {
    color: var(--on-inverse-muted);
    font-weight: 400;
  }

  .contact-btn {
    margin-top: 40px;
    min-width: 200px;
  }

  .social-list {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 32px;
  }

  .social-list a {
    font-size: var(--text-md);
  }
</style>
