---
// 作品卡片：图片 + 标题 + 类别 + 年份
// cover 图片放在 public/projects/ 下，md 里填相对路径
// 未提供图片时显示渐变占位
interface Props {
  project: {
    slug: string;
    data: {
      title: string;
      category?: string;
      year?: string;
      cover?: string;
      description?: string;
    };
  };
}

const { project } = Astro.props;
const { title, category, year, cover, description } = project.data;
---

<a href={`/projects/${project.slug}/`} class="project-card">
  <div class="cover">
    {
      cover ? (
        <img src={cover} alt={title} loading="lazy" />
      ) : (
        <div class="cover-placeholder" aria-hidden="true">
          <span class="placeholder-glyph">{title.charAt(0)}</span>
        </div>
      )
    }
    <span class="cover-arrow" aria-hidden="true">→</span>
  </div>

  <div class="meta">
    <div class="meta-row">
      <h3 class="title">{title}</h3>
      <div class="tags">
        {category && <span class="tag">{category}</span>}
        {year && <span class="tag tag-year">{year}</span>}
      </div>
    </div>
    {description && <p class="desc">{description}</p>}
  </div>
</a>

<style>
  .project-card {
    display: block;
  }

  .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-muted);
    border: 1px solid var(--border);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
      linear-gradient(160deg, var(--surface-muted), var(--surface));
  }

  .placeholder-glyph {
    font-size: clamp(48px, 8vw, 88px);
    font-weight: 700;
    color: color-mix(in srgb, var(--text) 14%, transparent);
    letter-spacing: 0.02em;
  }

  .cover-arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #1a1a18;
    font-size: 18px;
    opacity: 0;
    transform: translateY(6px);
    transition: all var(--dur) var(--ease);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.14);
  }

  .project-card:hover .cover img {
    transform: scale(1.04);
  }

  .project-card:hover .cover-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .meta {
    margin-top: 16px;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project-card:hover .title {
    color: var(--accent);
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .tag {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    background: var(--surface-muted);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .tag-year {
    background: transparent;
    border: 1px solid var(--border);
  }

  .desc {
    margin-top: 6px;
    font-size: 14px;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 560px) {
    .meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
