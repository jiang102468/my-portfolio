---
// 作品瓦片：全宽明暗面 + 左侧文案 + 右侧海报（Apple 产品瓦片语法）
// cover 图片放在 public/projects/ 下，md 里填路径；缺省显示排版占位
import type { CollectionEntry } from 'astro:content';
import { site } from '../site.config';

interface Props {
  project: CollectionEntry<'projects'>;
  tone: 'dark' | 'light' | 'dark-alt';
}

const { project, tone } = Astro.props;
const { title, category, year, cover, description } = project.data;

// tone → 全局瓦片类（global.css 维护，含深色面 accent 切换）
const tileClass = {
  dark: 'tile-dark',
  light: 'tile-light',
  'dark-alt': 'tile-dark-2',
}[tone];
---

<a href={`/projects/${project.slug}/`} class={`work-tile ${tileClass}`}>
  <div class="container work-inner">
    <div class="work-copy">
      <div class="work-tags">
        {category && <span class="tag">{category}</span>}
        {year && <span class="tag tag-year">{year}</span>}
      </div>

      <h3 class="work-title">{title}</h3>
      {description && <p class="work-desc">{description}</p>}

      <span class="work-link text-link">
        {site.projects.ctaLabel}
        <span aria-hidden="true"> ↗</span>
      </span>
    </div>

    <div class="work-poster">
      {
        cover ? (
          <img src={cover} alt={title} width="480" height="360" loading="lazy" style="aspect-ratio: 4 / 3; width: 100%; height: 100%; object-fit: cover;" />
        ) : (
          <div class="poster-placeholder" aria-hidden="true">
            <span class="poster-glyph">{title.charAt(0)}</span>
          </div>
        )
      }
      <span class="poster-arrow" aria-hidden="true">→</span>
    </div>
  </div>
</a>

<style>
  /* 全宽瓦片：利用负 margin 冲破 container，内容仍随容器居中 */
  .work-tile {
    display: block;
    margin-inline: calc(50% - 50vw);
    padding-block: var(--space-section);
  }

  .work-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .work-title {
    font-size: clamp(30px, 4.5vw, 40px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .work-desc {
    margin-top: 14px;
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.5;
    max-width: 42ch;
  }

  .work-link {
    margin-top: 28px;
    font-size: var(--text-md);
    min-height: 40px;
    line-height: 40px;
  }

  /* 海报：18px 圆角卡片，深色面上自动用浅底/发丝线 */
  .work-poster {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-muted);
    border: 1px solid var(--border);
  }

  .tile-light .work-poster {
    background: var(--bg);
  }

  .work-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;          /* 锁定比例防 CLS */
    transition: transform var(--dur-slow) var(--ease);
  }

  .poster-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  .poster-glyph {
    font-size: clamp(64px, 9vw, 110px);
    font-weight: 600;
    line-height: 1;
    color: color-mix(in srgb, currentColor 12%, transparent);
    letter-spacing: -0.02em;
  }

  /* 玻璃圆钮：Apple button-icon-circular（44px 触控目标） */
  .poster-arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(210 210 215 / 0.64);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    color: #1d1d1f;
    font-size: 18px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .work-tile:hover .work-poster img,
  .work-tile:focus-within .work-poster img {
    transform: scale(1.03);
  }

  .work-tile:hover .poster-arrow,
  .work-tile:focus-within .poster-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  /* 触屏设备无 hover：常显轻提示，避免隐藏可点击信号 */
  @media (hover: none) {
    .poster-arrow {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 平板及以下：单列，文案在上、海报在下 */
  @media (max-width: 768px) {
    .work-tile {
      padding-block: 64px;
    }

    .work-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
    }
  }
</style>
