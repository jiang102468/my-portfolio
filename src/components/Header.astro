---
// 顶部导航：Apple 式极简导航 + 毛玻璃吸顶 + 移动端汉堡菜单
import { site } from '../site.config';

const { name: siteName, nav } = site;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="返回首页">
      <span class="logo-text">{siteName}</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
      <span class="nav-toggle-line" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" data-nav aria-label="主导航">
      <ul>
        {
          nav.items.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={nav.cta.href} class="nav-cta">{nav.cta.label}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* 毛玻璃吸顶导航：Apple sub-nav 语法，滚动后浮现发丝线 */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: var(--bg); /* color-mix 不支持时的 fallback */
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-text {
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.374px;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 32px);
  }

  .nav-link {
    font-size: var(--text-xs); /* Apple 全局导航 12px */
    letter-spacing: -0.12px;
    color: var(--text-secondary);
    min-height: 40px;          /* 触控目标 ≥40px */
    display: inline-flex;
    align-items: center;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  /* 蓝色小胶囊 CTA：Apple「Buy」语法 */
  .nav-cta {
    font-size: var(--text-sm);
    letter-spacing: -0.224px;
    min-height: 32px;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .nav-cta:hover {
    background: var(--accent-strong);
  }

  .nav-cta:active {
    transform: scale(0.95);
  }

  /* 汉堡按钮：无边框极简三条线，视觉 36px、触控热区 44px */
  .nav-toggle {
    position: relative;
    display: none;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: var(--radius-pill);
    -webkit-tap-highlight-color: transparent;
  }

  .nav-toggle::before {
    content: "";
    position: absolute;
    inset: -4px; /* 36 + 4×2 = 44 触控热区 */
  }

  .nav-toggle:active {
    transform: scale(0.95);
  }

  .nav-toggle-line {
    position: absolute;
    left: 9px;
    width: 18px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--text);
    transition:
      transform var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .nav-toggle-line:nth-child(1) { top: 12px; }
  .nav-toggle-line:nth-child(2) { top: 17px; }
  .nav-toggle-line:nth-child(3) { top: 22px; }

  .nav-toggle.is-active .nav-toggle-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .nav-toggle.is-active .nav-toggle-line:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.is-active .nav-toggle-line:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* 移动端：毛玻璃下拉面板 */
  @media (max-width: 640px) {
    .nav-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      display: none;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }

    .nav.is-open {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 20px;
    }

    .nav li {
      border-bottom: 1px solid var(--border);
    }

    .nav li:last-child {
      border-bottom: none;
    }

    .nav-link,
    .nav-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 14px 4px;
      border-radius: var(--radius-md);
      font-size: var(--text-md);
    }

    .nav-cta {
      margin-top: 12px;
      background: var(--accent);
      color: #fff;
    }
  }
</style>

<script>
  // Header 滚动状态 + 移动端汉堡菜单
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');

  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.classList.toggle('is-active', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    };

    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (header && event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
