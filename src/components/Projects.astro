---
// 作品展示区块：明暗瓦片堆叠（Apple 画廊节奏）
// 项目内容在 src/content/projects/*.md 中维护
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { site } from '../site.config';

const projects = (await getCollection('projects')).sort(
  (a, b) => (b.data.year || '').localeCompare(a.data.year || ''),
);

// 瓦片节奏：深 → 浅 → 深（色块切换即分区分隔）
const tones = ['dark', 'light', 'dark-alt'] as const;
---

<section id="work" class="work">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{site.projects.eyebrow}</span>
      <h2 class="section-title">{site.projects.title}</h2>
    </div>

    {
      projects.length > 0 ? (
        <div class="work-stack">
          {
            projects.map((project, index) => (
              <ProjectCard project={project} tone={tones[index % tones.length]} />
            ))
          }
        </div>
      ) : (
        <p class="empty-hint">
          {site.projects.emptyHint}
        </p>
      )
    }
  </div>
</section>

<style>
  .work {
    padding-block: var(--space-section) 0;
  }

  .work-stack {
    display: flex;
    flex-direction: column;
  }

  .empty-hint {
    padding: 48px;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
  }

  .empty-hint code {
    font-family: var(--font-mono);
    background: var(--surface-muted);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }
</style>
